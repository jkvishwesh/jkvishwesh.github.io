{
  "name": "jkvishwesh.github.io",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "clean": "rimraf ./node_modules",
    "clean:dist": "rimraf ./dist",
    "build": "vite build && cd ./dist && cp index.html 404.html",
    "preview": "vite preview",
    "test:unit": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "prepare": "husky"
  },
  "dependencies": {
    "disable-devtool": "^0.3.9",
    "jkvishwesh.github.io": "file:",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "sass": "^1.105.0",
    "vite": "^8.3.1",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.2",
    "vue-eslint-parser": "^10.4.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
